<!DOCTYPE html>
<html>
<head>
  <title>Vilaw Activation Code</title>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body style="margin:0; padding:0; min-width:100%; font-family:Arial, sans-serif; font-size:16px; line-height:1.5; background-color:#FAFAFA; color:#222;">
  <div style="max-width:600px; margin:0 auto;">
    <div style="background-color:#0070f3; padding:24px; color:#fff; text-align:center;">
      <h1 style="font-size:24px; font-weight:700; margin:0;">Your New Activation Code</h1>
    </div>
    <div style="padding:24px; background-color:#fff;">
      <p style="margin-top:0; margin-bottom:24px;">Hello {{name}},</p>
      <p style="margin-top:0; margin-bottom:24px;">You requested a new activation code for your @VilawLegisAi account. Use the code below:</p>
      <h2 style="font-size:20px; font-weight:700; text-align:center; margin:0 0 15px 0;">{{activationCode}}</h2>
      <p style="margin-top:0; margin-bottom:24px;">This code expires in 50 minutes.</p>
      <p style="margin-top:0; margin-bottom:24px;">If you didn't request this, you can ignore this email.</p>
    </div>
   
  </div>
</body>
</html>

